# Dev API port (the Vite proxy expects 5000). In production the server listens on PORT instead.
API_PORT=5000
# Leave MONGO_URI empty to use a local dev MongoDB (auto-seeded on first run). Its data is kept in
# server/.data so logins and IDs survive restarts; delete that folder, or set MEMORY_DB_PERSIST=false
# for a fresh database on every start.
# Local:  mongodb://127.0.0.1:27017/medicare_connect
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/medicare_connect
MONGO_URI=
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Emails that become admin when they "Continue with Google" (comma-separated). Password sign-up never grants admin,
# because it does not verify the email address.
ADMIN_EMAILS=sumitmmmut1@gmail.com
# Timezone that doctors' working hours are in; slots that have started in this zone can no longer be booked.
CLINIC_TIMEZONE=Asia/Kolkata

# Hospitals across India from data.gov.in (National Health Portal hospital directory).
# Free API key: sign in at https://www.data.gov.in -> My Account -> API key. This is the only setting the import needs.
DATA_GOV_IN_API_KEY=
# Optional: defaults to the National Hospital Directory (98fa254e-c5f8-4910-a19b-4828939b477d).
DATA_GOV_IN_HOSPITAL_RESOURCE_ID=
# How many records to import at most (the full directory has tens of thousands; 50000 covers every state)
HOSPITAL_IMPORT_LIMIT=50000

# ABDM Healthcare Professionals Registry lookup (optional). Credentials come from your ABDM sandbox
# registration (https://sandbox.abdm.gov.in). Copy the HPR "fetch professional by HPR ID" endpoint
# from the sandbox docs into ABDM_HPR_LOOKUP_URL; "{hprId}" in it is replaced with the doctor's ID.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HPR_LOOKUP_URL=
ABDM_HPR_LOOKUP_METHOD=POST
ABDM_SESSION_URL=https://dev.abdm.gov.in/gateway/v0.5/sessions
ABDM_CM_ID=sbx

# "Continue with Google": OAuth 2.0 Web Client ID from Google Cloud Console (same value as
# VITE_GOOGLE_CLIENT_ID in client/.env). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Email for password reset links. Leave SMTP_HOST empty in development: the reset link is
# printed in the server terminal and shown on the Forgot Password page instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediCare Connect <no-reply@medicare.dev>
